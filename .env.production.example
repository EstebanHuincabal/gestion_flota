# ─────────────────────────────────────────────────────────────────────────────
# Variables de entorno de PRODUCCIÓN. En el servidor:
#   cp .env.production.example .env.production   y edita los valores marcados.
# NO subas .env.production a git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Django ───────────────────────────────────────────────────────────────────
# Genera SECRET_KEY:    python -c "import secrets;print(secrets.token_urlsafe(64))"
SECRET_KEY=CAMBIAR_por_clave_secreta_larga_y_aleatoria
# ENCRYPTION_KEY: clave base del cifrado de datos. ¡GUÁRDALA Y NO LA CAMBIES!
# Si la pierdes o la cambias, los datos cifrados (RUT, email, patente, GPS...) se vuelven ilegibles.
# Genérala con: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=CAMBIAR_por_clave_de_cifrado_estable

DEBUG=False
ALLOWED_HOSTS=157.180.85.17,localhost

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_DB=Nombre_de_tu_base_de_datos
POSTGRES_USER=usuario_db
# Evita el carácter '|' en la contraseña: el traccar.xml se genera con `sed` y ese
# carácter es el delimitador. Letras, números y otros símbolos no dan problema.
POSTGRES_PASSWORD=password_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ── Redis (capa de canales para WebSockets) ──────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Orígenes del servidor (IP pública) ───────────────────────────────────────
CORS_ALLOWED_ORIGINS_EXTRA=http://157.180.85.17
CSRF_TRUSTED_ORIGINS_EXTRA=http://157.180.85.17
FRONTEND_URL=http://157.180.85.17

# ── Traccar (gateway GPS) ────────────────────────────────────────────────────
# El backend alcanza Traccar por el nombre de servicio de docker-compose.
TRACCAR_URL=http://traccar:8082
# Credenciales del admin que el servicio 'traccar-init' crea automáticamente en
# el primer arranque. Usa estas mismas para entrar a la web de Traccar (:8082).
TRACCAR_USER=admin@tudominio.cl
TRACCAR_PASSWORD=CAMBIAR_por_password_admin_traccar
# Clave opcional para proteger el webhook Traccar→backend. Si la defines, hay que
# configurar Traccar para enviarla en el header X-Webhook-Key (ver forward.header).
# Vacía: el webhook queda abierto pero solo dentro de la red interna de Docker.
GPS_WEBHOOK_KEY=

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATELIMIT_ENABLE=True

# ── Transbank (Webpay). 'integration' para pruebas; 'production' con tus credenciales ──
# Completá con tus credenciales reales en el servidor (NO las dejes en el repo).
TRANSBANK_ENVIRONMENT=integration
TRANSBANK_COMMERCE_CODE=
TRANSBANK_API_KEY=
# OneClick Mall (tarjeta guardada / cobros automáticos)
ONECLICK_COMMERCE_CODE=
ONECLICK_CHILD_CODE=

# ── Moderación de contenido (Gemini) ──────────────────────────────────────────
# Clave gratuita: https://aistudio.google.com/apikey
# Si se deja vacío, la moderación solo usa el filtro de diccionario.
GEMINI_API_KEY=

