# ─────────────────────────────────────────────────────────────────────────────
# Variables de entorno de PRODUCCIÓN. En el servidor:
#   cp .env.production.example .env.production   y edita los valores marcados.
# NO subas .env.production a git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Django ───────────────────────────────────────────────────────────────────
# Genera SECRET_KEY:    python -c "import secrets;print(secrets.token_urlsafe(64))"
SECRET_KEY=CAMBIAR_por_clave_secreta_larga_y_aleatoria
# ENCRYPTION_KEY: clave base del cifrado de datos. ¡GUÁRDALA Y NO LA CAMBIES!
# Si la pierdes o la cambias, los datos cifrados (RUT, email, patente, GPS...) se vuelven ilegibles.
ENCRYPTION_KEY=CAMBIAR_por_clave_de_cifrado_estable
# Genera FERNET_KEY:    python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
FERNET_KEY=CAMBIAR_por_fernet_key_base64

DEBUG=False
ALLOWED_HOSTS=157.180.85.17,localhost

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_DB=Nombre_de_tu_base_de_datos
POSTGRES_USER=usuario_db
POSTGRES_PASSWORD=password_db
POSTGRES_HOST=database  
POSTGRES_PORT=puerto_db

# ── Redis (capa de canales para WebSockets) ──────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Orígenes del servidor (IP pública) ───────────────────────────────────────
CORS_ALLOWED_ORIGINS_EXTRA=http://157.180.85.17
CSRF_TRUSTED_ORIGINS_EXTRA=http://157.180.85.17
FRONTEND_URL=http://157.180.85.17

# ── Transbank (Webpay). 'integration' para pruebas; 'production' con tus credenciales ──
TRANSBANK_ENVIRONMENT=integration

